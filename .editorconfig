root = true

# Configurações gerais
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Arquivos C#
[*.cs]
# Projeto atualizado para C# 12

# CA1510: ArgumentNullException.ThrowIfNull no lugar de if/throw. Como aviso, o
# TreatWarningsAsErrors do Directory.Build.props barra a volta do padrão antigo no build.
dotnet_diagnostic.CA1510.severity = warning

# Projetos de exemplo (src/*Samples*): o Skip é o opt-in do exemplo. Cada teste roda contra o
# ambiente de quem usa o pacote (API publicada, broker, certificado), e quem quer rodá-lo tira o
# Skip. Nos testes do framework (XUnitAssured.Tests) o xUnit1004 continua valendo.
[src/*Samples*/**.cs]
dotnet_diagnostic.xUnit1004.severity = none
