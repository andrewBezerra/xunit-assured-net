{
    // ============================================================================
    // KAFKA LOCAL DOCKER CONFIGURATION - SASL/PLAIN without SSL
    // Matches docker-compose.yml in this folder: SASL_PLAINTEXT on localhost:9093,
    // users from kafka_jaas.conf
    // ============================================================================

    "testMode": "Local",
    "environment": "docker-local",

    "kafka": {
        // The EXTERNAL listener of docker-compose.yml
        "bootstrapServers": "localhost:9093",

        // Consumer group ID
        "groupId": "xunit-test-consumer-group",

        // SASL/PLAIN without SSL. The credentials can also go at this level, with the
        // Confluent names ("securityProtocol": "SaslPlaintext", "saslMechanism": "Plain",
        // "saslUsername", "saslPassword"); when both are set, "authentication" wins.
        "authentication": {
            "type": "SaslPlain",
            "saslPlain": {
                "username": "admin",
                "password": "admin-secret",
                "useSsl": false
            }
        }
    }
}
