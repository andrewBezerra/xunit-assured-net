{
    // ============================================================================
    // KAFKA LOCAL DOCKER CONFIGURATION
    // ============================================================================

    "testMode": "Local",
    "environment": "docker-local",

    "kafka": {
        // Bootstrap servers (comma-separated if multiple)
        // Using "localhost" hostname for connections from the host machine
        // The broker certificate names "kafka", "localhost" and 127.0.0.1, so any of them works
        // with the hostname check on ("kafka" needs 127.0.0.1 kafka in your hosts file)
        "bootstrapServers": "localhost:39093",

        // Consumer group ID
        "groupId": "xunit-test-consumer-group",

        // Security protocol (SaslSsl for SASL with SSL encryption)
        "securityProtocol": "SaslSsl",

        // The CA that signed the broker certificate. A relative path is read from the folder
        // of this file, whatever folder the test runner starts in
        "sslCaLocation": "secrets/ca-cert.pem",

        // Verify the broker's certificate against the CA above
        "enableSslCertificateVerification": true,

        // Only if your broker certificate does not name the host you connect to:
        // "sslEndpointIdentificationAlgorithm": "None",

        // Authentication configuration for SASL/SCRAM-SHA-512 with SSL
        "authentication": {
            "type": "SaslScram512",
            "saslScram": {
                "username": "admin",
                "password": "admin-secret",
                "useSsl": true
            }
        },

        // Schema Registry URL (optional - not used in basic tests)
        "schemaRegistry": {
            "url": "http://localhost:8081"
        }
    }
}
