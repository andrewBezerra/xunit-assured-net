<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>JSONata expressions for XUnitAssured: select, transform and assert on the JSON a step returns, with a time limit, a recursion limit and helper functions such as $jwt. Built on Jsonata.Net.Native.</Description>
		<PackageId>XUnitAssured.Jsonata</PackageId>
		<PackageTags>xunit;jsonata;json;expressions;assertions;integration-testing;quality-assurance</PackageTags>
		<RootNamespace>XUnitAssured.Jsonata</RootNamespace>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<!--
		O porte .NET da JSONata, sem dependências. Medido contra a suíte oficial (jsonata-js 2.2.2): passa
		1386 de 1690 casos; o grosso do que falha é formato de data e número, que ele faz no formato do .NET.
	-->
	<ItemGroup>
		<PackageReference Include="Jsonata.Net.Native" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\package-icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="XUnitAssured.Tests" />
	</ItemGroup>

</Project>
