<Project>

  <!--
    Settings shared by every project in the solution.
    Package metadata that is identical across packages lives here so it cannot
    drift between the individual .csproj files; anything package-specific
    (PackageId, Description, PackageTags) stays in the project itself.

    This file is imported before the project body, so it cannot read properties
    the .csproj sets (IsPackable, GeneratePackageOnBuild). IsShippingLibrary below
    identifies the shipping packages from the project name instead — several SDK
    defaults, GenerateDocumentationFile among them, are already locked in by the
    time Directory.Build.targets runs, so they have to be decided here.
  -->

  <PropertyGroup>
    <!--
      True for the published packages and false for test and sample projects, and
      for the source generator, which runs only while the packages compile. A test
      project is one whose name ends in .Test or .Tests: a package may contain "Test"
      (XUnitAssured.Camunda.Testcontainers), and with Contains("Test") it shipped in
      6.27.0 without XML docs, symbols or SourceLink. This file is imported before the
      .csproj, so setting the property there does not reach the packaging below.
    -->
    <IsShippingLibrary Condition="'$(IsShippingLibrary)' == '' AND !$(MSBuildProjectName.EndsWith('.Test')) AND !$(MSBuildProjectName.EndsWith('.Tests')) AND !$(MSBuildProjectName.Contains('Sample')) AND !$(MSBuildProjectName.EndsWith('SourceGenerators'))">true</IsShippingLibrary>
    <IsShippingLibrary Condition="'$(IsShippingLibrary)' == ''">false</IsShippingLibrary>
  </PropertyGroup>

  <PropertyGroup>
    <Version>6.31.2</Version>

    <!--
      O que a página do pacote no nuget.org mostra. Sem isto ela fica muda, e quem atualiza
      por `dotnet add package` não recebe nenhum aviso de que a major quebra coisas.
      Trocar a cada versão, junto do número acima.
    -->
    <PackageReleaseNotes>New package XUnitAssured.Camunda: deploy BPMN, start real Camunda 8.10 process instances on a shared cluster and mock the diagram's job workers per instance, with assertions that wait for the cluster. The other packages are unchanged from 6.19.1. Upgrade guide: https://github.com/andrewBezerra/xunit-assured-net/blob/main/UPGRADING.md</PackageReleaseNotes>
    <Authors>Carlos Andrew Costa Bezerra</Authors>
    <Company>Carlos Andrew Costa Bezerra</Company>
    <Copyright>Copyright (c) Carlos Andrew Costa Bezerra</Copyright>
    <PackageProjectUrl>https://github.com/andrewBezerra/xunit-assured-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andrewBezerra/xunit-assured-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Aviso vira erro, em todos os projetos: o build chegou a 380 avisos, e o próximo aviso de
    verdade não teria sido visto no meio deles (#124). Os de vulnerabilidade de pacote ficam como
    aviso: um alerta publicado amanhã não pode quebrar um build que ninguém mudou.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Reproducible builds. ContinuousIntegrationBuild normalises the source paths
    embedded in the assembly so a package built from a given commit on CI is
    reproducible. It is only set on CI, where the sources genuinely come from
    the repository root.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Packaging concerns, for the shipping libraries only. -->
  <PropertyGroup Condition="'$(IsShippingLibrary)' == 'true'">
    <!--
      Ship debugging symbols and link them back to the source on GitHub, so a
      consumer can step into the framework when a test fails inside it.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- The public API is documented with XML comments; publish them with the package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Os pacotes referenciam o xunit, e o scanner do Sonar toma por projeto de teste quem o
      referencia: na primeira análise, nenhuma linha das bibliotecas contou, nem na cobertura.
    -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsShippingLibrary)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

</Project>
