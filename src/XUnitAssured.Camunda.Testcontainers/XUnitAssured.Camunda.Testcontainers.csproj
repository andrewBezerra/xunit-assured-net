<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Starts Camunda 8.10 inside dotnet test for XUnitAssured.Camunda: CamundaContainerFixture runs camunda/camunda in Docker with Testcontainers (H2 in memory, search flushed at once, a random password) and hands its address and credentials to every chain, so a CI runner with Docker needs no Camunda of its own.</Description>
		<PackageId>XUnitAssured.Camunda.Testcontainers</PackageId>
		<PackageTags>xunit;camunda;zeebe;bpmn;testcontainers;docker;process-testing;integration-testing</PackageTags>
		<RootNamespace>XUnitAssured.Camunda.Testcontainers</RootNamespace>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Testcontainers" Version="4.16.0" />
		<!-- O IAsyncLifetime do xUnit v2, para o fixture subir e derrubar o container. -->
		<PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\package-icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\XUnitAssured.Camunda\XUnitAssured.Camunda.csproj" />
	</ItemGroup>

</Project>
